#ifndef WBE_FILE_LABEL_MANAGER_GEN_HH
#define WBE_FILE_LABEL_MANAGER_GEN_HH

#include "utils/utils.hh"
#include "utils/interface/i_singleton.hh"

#include <unordered_map>
#include <string>
#include <vector>
#include <shared_mutex>

namespace WhiteBirdEngine {

template <HashCode T>
struct LabelName {};

{% for label in metadata.labels %}
{% if label.attribute | select("in", static_labels) | list | length > 0  %}
/**
 * @class LabelName<static_hash("{{ label.name }}")>
 * @brief Label name finder for {{ label.name }}.
 */
template <>
struct LabelName<static_hash("{{ label.name }}")> {
    static constexpr std::string_view LABEL_NAME = "{{ label.name }}";
};
{% endif %}
{% endfor %}

/**
 * @class LabelManager
 * @brief The manager for all the dynamic labels.
 */
class LabelManager : public ISingleton<LabelManager> {
public:
    LabelManager() {
        singleton = this;
        {% for label in metadata.labels %}
        {% if label.attribute | select("in", dynamic_labels) | list | length > 0  %}
        label_to_name.insert({static_hash("{{ label.name }}"), std::string("{{ label.name }}")});
        name_to_label.insert({std::string("{{ label.name }}"), static_hash("{{ label.name }}")});
        {% endif %}
        {% endfor %}
    }
    virtual ~LabelManager() override {
        singleton = nullptr;
    }

    /**
     * @brief Check if the label exists.
     *
     * @param p_label The label to check.
     * @return True if the label exists, false otherwise.
     */
    bool is_registered(HashCode p_label) const {
        std::shared_lock lock(label_mutex);
        return label_to_name.find(p_label) != label_to_name.end();
    }

    /**
     * @brief Get the name of the label.
     *
     * @param p_label The label to get the name from.
     * @return The name of the label
     */
    const std::string& get_label_name(HashCode p_label) const {
        std::shared_lock lock(label_mutex);
        if (!label_to_name.contains(p_label)) {
            throw std::runtime_error(std::format("Failed to get name from label {}: Label not registered.", p_label));
        }
        return label_to_name.at(p_label);
    }

    /**
     * @brief Get the label from the label's name.
     *
     * @param p_name The name of the label.
     * @return The label.
     */
    HashCode get_label_from_name(std::string_view p_name) const {
        std::shared_lock lock(label_mutex);
        if (!name_to_label.contains(p_name)) {
            throw std::runtime_error(std::format("Failed to get label from name {}: Label not registered.", p_name));
        }
        return name_to_label.at(std::string(p_name)); // waiting for C++26...
    }

    /**
     * @brief Register a label.
     *
     * @param p_name The name of the label to register.
     */
    void register_label(std::string_view p_name) {
        std::unique_lock lock(label_mutex);
        label_to_name.insert({dynam_hash(p_name), std::string(p_name)});
    }

    /**
     * @brief Get the singleton instance.
     */
    static LabelManager* get_singleton() {
        return singleton;
    }

private:
    inline static LabelManager* singleton = nullptr;
    std::unordered_map<HashCode, std::string> label_to_name;
    std::unordered_map<std::string, HashCode, TransparentStrHash, TransparentEqual> name_to_label;
    mutable std::shared_mutex label_mutex;
};

} // namespace WhiteBirdEngine

#endif
