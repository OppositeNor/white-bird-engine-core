#ifndef __WBE_LABEL_MANAGER_HH__
#define __WBE_LABEL_MANAGER_HH__

#include "utils/utils.hh"
#include "utils/interface/singleton.hh"

#include <map>
#include <string>
#include <vector>

namespace WhiteBirdEngine {

template <HashCode T>
struct LabelName {};

{% for label in metadata.labels %}
{% if label.attribute | select("in", static_labels) | list | length > 0  %}
/**
 * @class LabelName<static_hash("{{ label.name }}")>
 * @brief Label name finder for {{ label.name }}.
 */
template <>
struct LabelName<static_hash("{{ label.name }}")> {
    static constexpr std::string_view LABEL_NAME = "{{ label.name }}";
};
{% endif %}
{% endfor %}

/**
 * @class LabelManager
 * @brief The manager for all the dynamic labels.
 */
class LabelManager : public Singleton<LabelManager> {
public:
    LabelManager() {
        singleton = this;
        {% for label in metadata.labels %}
        {% if label.attribute | select("in", dynamic_labels) | list | length > 0  %}
        dynamic_labels.push_back("{{ label.name }}");
        label_to_name.insert(std::pair(static_hash("{{ label.name }}"), std::string("{{ label.name }}")));
        name_to_label.insert(std::pair(std::string("{{ label.name }}"), static_hash("{{ label.name }}")));
        {% endif %}
        {% endfor %}
    }
    ~LabelManager() {
        singleton = nullptr;
    }

    /**
     * @brief Get the name of the label.
     *
     * @param p_label The label to get the name from.
     * @return The name of the label
     */
    const std::string& get_label_name(HashCode p_label) const {
        return label_to_name.at(p_label);
    }

    /**
     * @brief Get the label from the label's name.
     *
     * @param p_name The name of the label.
     * @return The label.
     */
    HashCode get_label_from_name(const std::string& p_name) const {
        return name_to_label.at(p_name);
    }

    /**
     * @brief Register a label.
     *
     * @param p_name The name of the label to register.
     */
    void register_label(const std::string& p_name) {
        dynamic_labels.push_back(p_name);
        label_to_name.insert(std::pair(dynam_hash(p_name), p_name));
    }

    /**
     * @brief Get the singleton instance.
     */
    static LabelManager* get_singleton() {
        return singleton;
    }

private:
    inline static LabelManager* singleton = nullptr;
    std::vector<std::string> dynamic_labels;
    std::map<HashCode, std::string> label_to_name;
    std::map<std::string, HashCode> name_to_label;
};

}

#endif
