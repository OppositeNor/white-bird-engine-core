// {{ _prefix }}
#ifndef WBE_FILE_CLA_CONFIGURATION_GEN_HH
#define WBE_FILE_CLA_CONFIGURATION_GEN_HH

#include <boost/program_options/options_description.hpp>
#include <boost/program_options/value_semantic.hpp>
#include <boost/program_options/variables_map.hpp>
#include <string>

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", cla_configurations) | list | length > 0  %}
#include "{{ serializable.in_header }}"
{% endif %}
{% endfor %}

namespace WhiteBirdEngine {

template <typename T>
class CLAConfiguration {
public:
    static void add_options(boost::program_options::options_description& /*p_options*/) {
    }

    static void apply(const boost::program_options::variables_map& /*p_arguments*/, T& /*p_target*/) {
    }
};

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", cla_configurations) | list | length > 0  %}
template <>
class CLAConfiguration<{{ serializable.name }}> {
public:
    static void add_options(boost::program_options::options_description& p_options) {
        p_options.add_options()
        {% for field in serializable.fields %}
            ("{{ field.name }}", boost::program_options::value<decltype({{ serializable.name }}::{{ field.name }})>(), "Override {{ field.name }}.")
        {% endfor %}
        ;
    }

    static void apply(const boost::program_options::variables_map& p_arguments, {{ serializable.name }}& p_target) {
        {% for field in serializable.fields %}
        if (p_arguments.contains("{{ field.name }}")) {
            p_target.{{ field.name }} = p_arguments["{{ field.name }}"].as<decltype(p_target.{{ field.name }})>();
        }
        {% endfor %}
    }
};
{% endif %}
{% endfor %}

} // namespace WhiteBirdEngine

#endif
