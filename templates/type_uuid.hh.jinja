// {{ _prefix }}
#ifndef WBE_FILE_TYPE_UUID_GEN_HH
#define WBE_FILE_TYPE_UUID_GEN_HH

#include "utils/utils.hh"
{% for type in metadata.classes %}
#include "{{ type.in_header }}"
{% endfor %}

#include <format>
#include <stdexcept>
#include <unordered_map>

namespace WhiteBirdEngine {
template <typename T>
struct TypeUUID {};

{% for type in metadata.classes %}
/**
 * @class TypeUUID<{{ type.name }}>
 * @brief Type UUID of <{{ type.name }}>
 */
template <>
struct TypeUUID<{{ type.name }}> {
    // The type.
    using Type = {{ type.name }};
    // The type UUID.
    static constexpr TypeID UUID = static_hash("{{ type.name }}");
};
{% endfor %}

/**
 * @class TypeUUIDManager
 * @brief Manager class for types' ID.
 */
class TypeUUIDManager : public ISingleton<TypeUUIDManager> {
public:
    TypeUUIDManager() : ISingleton<TypeUUIDManager>() {
        singleton = this;
        {% for type in metadata.classes %}
        type_name_map[TypeUUID<{{ type.name }}>::UUID] = "{{ type.name }}";
        {% endfor %}
    }
    virtual ~TypeUUIDManager() override {
        singleton = nullptr;
    }

    /**
     * @brief Get the name of a type according to its type UUID.
     *
     * @param p_type_uuid The UUID of the type to get name from.
     * @return The name of the type.
     */
    const std::string& get_type_name(TypeID p_type_uuid) const {
        auto found = type_name_map.find(p_type_uuid);
        if (found == type_name_map.end()) {
            throw std::runtime_error(std::format("Type with id: {} not registered.", p_type_uuid));
        }
        return found->second;
    }

    /**
     * @brief Check if a type is registered.
     *
     * @param p_type_uuid The UUID of the type to check.
     * @return True if the type is registered, false otherwise.
     */
    bool is_registered(TypeID p_type_uuid) const {
        return type_name_map.find(p_type_uuid) != type_name_map.end();
    }

    /**
     * @brief Get the singleton instance.
     */
    static TypeUUIDManager* get_singleton() {
        return singleton;
    }

private:
    inline static TypeUUIDManager* singleton = nullptr;
    std::unordered_map<TypeID, std::string> type_name_map;
};

} // namespace WhiteBirdEngine

#endif
